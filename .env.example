APP_NAME=RecoverAI
ENVIRONMENT=local
DEBUG=true

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=recoverai_local_dev
POSTGRES_DB=recoverai

DATABASE_URL=postgresql+psycopg://postgres:recoverai_local_dev@localhost:5433/recoverai
TEST_DATABASE_URL=postgresql+psycopg://postgres:recoverai_local_dev@localhost:5433/recoverai_test

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_DEFAULT_QUEUE=recoverai

# Outbox dispatcher
OUTBOX_DISPATCH_BATCH_SIZE=10
OUTBOX_DISPATCH_INTERVAL_SECONDS=2
OUTBOX_MAX_DISPATCH_ATTEMPTS=10

# Razorpay test-mode secrets
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=local_webhook_secret_change_me
